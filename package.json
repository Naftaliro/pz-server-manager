{
  "name": "pz-server-manager",
  "version": "1.6.0",
  "description": "Knox Launcher: host Project Zomboid servers and join friends' servers with the same mods",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:win": "tsc && vite build && electron-builder --win",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "keywords": [
    "project-zomboid",
    "server-manager",
    "electron"
  ],
  "author": "Naftaliro",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.9.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "lucide-react": "^0.316.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.3",
    "uuid": "^9.0.1",
    "zustand": "^4.5.0"
  },
  "build": {
    "appId": "com.pzservermanager.app",
    "productName": "Knox Launcher",
    "forceCodeSigning": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Knox Launcher",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Knox-Launcher-Setup-${version}.exe"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "local-mods",
        "to": "local-mods",
        "filter": [
          "**/*",
          "!install.ps1",
          "!README.md"
        ]
      }
    ],
    "executableName": "PZ Server Manager"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
